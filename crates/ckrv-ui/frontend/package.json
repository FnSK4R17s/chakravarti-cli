{
  "name": "frontend",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:types": "cd ../../.. && cargo test -p ckrv-transport --features typescript export_typescript_types -- --ignored && echo 'TypeScript types generated at src/types/api.generated.ts'",
    "test": "cross-env NODE_ENV=test vitest",
    "test:run": "cross-env NODE_ENV=test vitest --run",
    "test:coverage": "cross-env NODE_ENV=test vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
