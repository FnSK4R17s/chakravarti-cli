{
    "identifier": "default",
    "description": "Default capabilities for the main window",
    "windows": [
        "main"
    ],
    "platforms": [
        "linux",
        "macOS",
        "windows"
    ],
    "permissions": [
        "core:default",
        "shell:allow-open",
        "dialog:allow-open",
        "dialog:allow-save",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file",
        "pty:default",
        "process:allow-restart",
        "process:allow-exit",
        "updater:default"
    ]
}