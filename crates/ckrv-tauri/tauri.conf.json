{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Chakravarti",
    "identifier": "dev.ckrv.app",
    "version": "0.3.3",
    "build": {
        "beforeBuildCommand": "cd ckrv-ui/frontend && npm run build",
        "beforeDevCommand": "cd ckrv-ui/frontend && npm run dev",
        "frontendDist": "../ckrv-ui/frontend/dist",
        "devUrl": "http://localhost:5173"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [],
        "category": "DeveloperTool",
        "shortDescription": "AI Agent Orchestration Engine",
        "longDescription": "Cross-platform orchestration engine for AI coding agents. Coordinate multiple AI agents working in parallel on isolated Git worktrees.",
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "macOS": {
            "minimumSystemVersion": "10.15"
        }
    },
    "app": {
        "windows": [
            {
                "title": "Chakravarti",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "shell": {
            "open": true
        },
        "updater": {
            "endpoints": [
                "https://github.com/FnSK4R17s/chakravarti-cli/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzM0JFNkRCRDQwOUM4MEQKUldRTnlBblUyK1k3SXg4RHRkandlK285ZWkrckd6b0dmQk42WDRSMFE0RThiZGZiczR0UldQQngK"
        }
    }
}