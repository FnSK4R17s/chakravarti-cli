# Chakravarti Agent Container
# Contains Claude Code CLI, OpenAI Codex CLI, and Kilo Code CLI for sandboxed agent execution

FROM node:22-slim

# Install dependencies and agent CLIs
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install OpenAI Codex CLI globally (still npm-based)
RUN npm install -g @openai/codex

# Install Kilo Code CLI globally (still npm-based)
RUN npm install -g @kilocode/cli

# Create non-root user with home directory
RUN useradd -m -s /bin/bash -d /home/agent agent && \
    mkdir -p /home/agent/.claude && \
    mkdir -p /home/agent/.codex && \
    mkdir -p /home/agent/.config/openai && \
    mkdir -p /home/agent/.config/kilo && \
    chown -R agent:agent /home/agent

# Create workspace directory
RUN mkdir -p /workspace && chown agent:agent /workspace

# Install Claude Code CLI using the native installer (npm package is deprecated)
# Install as the agent user so paths resolve correctly
USER agent
ENV HOME=/home/agent
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    ls -la $HOME/.local/bin/claude

# Switch back to root to create system-wide symlink
USER root
RUN ln -sf /home/agent/.local/bin/claude /usr/local/bin/claude

WORKDIR /workspace

# Verify all CLIs are installed (must run before USER switch)
RUN claude --version || true
RUN codex --version || true
RUN kilo --version || true

# Switch to non-root user
USER agent

# Default command
CMD ["/bin/bash"]