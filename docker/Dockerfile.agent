# Chakravarti Agent Container
# Contains Claude Code CLI, OpenAI Codex CLI, and Kilo Code CLI for sandboxed agent execution

FROM node:22-slim

# Install dependencies and agent CLIs
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Install OpenAI Codex CLI globally
RUN npm install -g @openai/codex

# Install Kilo Code CLI globally
RUN npm install -g @kilocode/cli

# Create /home/claude directory with open permissions
# This allows the container to run as any host user while using this home directory
RUN mkdir -p /home/claude/.claude && \
    chmod -R 777 /home/claude

# Create Codex config directory
RUN mkdir -p /home/claude/.codex && \
    mkdir -p /home/claude/.config/openai && \
    chmod -R 777 /home/claude/.codex /home/claude/.config

# Create Kilo config directory
RUN mkdir -p /home/claude/.config/kilo && \
    chmod -R 777 /home/claude/.config/kilo

# Create workspace directory with open permissions
RUN mkdir -p /workspace && chmod 777 /workspace

WORKDIR /workspace

# Verify all CLIs are installed (as root, before switching)
RUN claude --version || true
RUN codex --version || true
RUN kilo --version || true

# Default command
CMD ["/bin/bash"]

