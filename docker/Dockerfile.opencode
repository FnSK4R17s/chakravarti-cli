# Opencode agent container

FROM node:22-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Opencode CLI globally (package naming differs across releases)
RUN npm install -g opencode-ai || npm install -g @opencode-ai/cli

# Create non-root user
RUN useradd -m -s /bin/bash -d /home/opencode opencode && \
    mkdir -p /home/opencode/.config/opencode && \
    chown -R opencode:opencode /home/opencode

# Create workspace directory
RUN mkdir -p /workspace && chown opencode:opencode /workspace

WORKDIR /workspace

# Verify Opencode is installed (best effort)
RUN opencode --version || true

# Switch to non-root user
USER opencode

# Default command
CMD ["/bin/bash"]
