# Cursor agent container

FROM node:22-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Cursor CLI (package name varies across releases)
RUN npm install -g @cursor/cli || npm install -g cursor-cli || npm install -g cursor

# Create non-root user
RUN useradd -m -s /bin/bash -d /home/cursor cursor && \
    mkdir -p /home/cursor/.cursor && \
    mkdir -p /home/cursor/.config/cursor && \
    chown -R cursor:cursor /home/cursor

# Create workspace directory
RUN mkdir -p /workspace && chown cursor:cursor /workspace

WORKDIR /workspace
ENV HOME=/home/cursor

# Verify Cursor is installed (best effort)
RUN cursor --version || true

# Switch to non-root user
USER cursor

# Default command
CMD ["/bin/bash"]
